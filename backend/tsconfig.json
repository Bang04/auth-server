 {
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",

    "skipLibCheck": true,
    "incremental": true
  },
  "include": ["src/**/*"]
}

